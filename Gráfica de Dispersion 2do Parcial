import pandas as pd
import matplotlib.pyplot as plt

# 1. Cargar los datos
df = pd.read_csv("estudiantes.csv")

# 2. Lista con las 5 variables que quieres analizar
variables = ["Matricula", "Edad", "Asistencia", "Tareas", "Examen"]

# 3. Crear una figura con 3 filas y 2 columnas (6 espacios en total)
fig, axes = plt.subplots(nrows=3, ncols=2, figsize=(12, 14))

# 4. Aplanar la matriz de ejes para recorrerla del 0 al 5
axes = axes.flatten()

# 5. Dibujar cada gráfica de dispersión
for i, var in enumerate(variables):
    axes[i].scatter(df[var], df["Calificacion_Final"], color="royalblue", alpha=0.7)
    axes[i].set_xlabel(var)
    axes[i].set_ylabel("Calificación Final")
    axes[i].set_title(f"{var} vs Calificación Final")
    axes[i].grid(True, linestyle="--", alpha=0.5)

# 6. Ocultar el sexto gráfico (el que sobra abajo a la derecha) para que quede limpio
axes[-1].axis('off')

# 7. Ajustar diseño y mostrar
plt.tight_layout()
plt.show()
